# Sanity (crea el proyecto en https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Solo para cargar el contenido inicial (npm run seed). Token con permiso de escritura (Editor).
SANITY_API_WRITE_TOKEN=

# Webhook de n8n que recibe los formularios (contacto, evaluaciones, newsletter)
N8N_LEAD_WEBHOOK_URL=

# URL pública del sitio (para sitemap y metadatos)
NEXT_PUBLIC_SITE_URL=https://innovoo.ai
